<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_follow</name>
  <version>0.1.0</version>
  <description>Vision-based line following package for OriginBot tracked platform.</description>
  <maintainer email="support@example.com">yunbo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>hobot_usb_cam</exec_depend>
  <exec_depend>websocket</exec_depend>
  <exec_depend>hobot_codec</exec_depend>
  <exec_depend>hobot_shm</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
